{
  "version": "1.0",
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-chat",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.2,
    "max_tokens": 8192,
    "throttle_sec": 0.5,
    "languages": [
      "zh",
      "en"
    ],
    "analysis_concurrency": 4,
    "enrichment_concurrency": 2
  },
  "sources": {
    "github": [
      {
        "type": "repo_releases",
        "owner": "openai",
        "repo": "openai-python",
        "enabled": true,
        "category": "ai-engineering"
      },
      {
        "type": "repo_releases",
        "owner": "anthropics",
        "repo": "anthropic-sdk-python",
        "enabled": true,
        "category": "ai-engineering"
      },
      {
        "type": "repo_releases",
        "owner": "vercel",
        "repo": "next.js",
        "enabled": true,
        "category": "dev-platform"
      },
      {
        "type": "repo_releases",
        "owner": "astral-sh",
        "repo": "uv",
        "enabled": true,
        "category": "dev-platform"
      },
      {
        "type": "repo_releases",
        "owner": "OpenBB-finance",
        "repo": "OpenBB",
        "enabled": true,
        "category": "finance-tools"
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 35,
      "min_score": 100,
      "category": "tech-community"
    },
    "rss": [
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-engineering"
      },
      {
        "name": "GitHub Changelog",
        "url": "https://github.blog/changelog/feed/",
        "enabled": true,
        "category": "dev-platform"
      },
      {
        "name": "Cloudflare Blog",
        "url": "https://blog.cloudflare.com/rss/",
        "enabled": true,
        "category": "engineering"
      },
      {
        "name": "Federal Reserve Press Releases",
        "url": "https://www.federalreserve.gov/feeds/press_all.xml",
        "enabled": true,
        "category": "macro-policy"
      },
      {
        "name": "SEC Press Releases",
        "url": "https://www.sec.gov/news/pressreleases.rss",
        "enabled": true,
        "category": "regulation"
      },
      {
        "name": "FRED Blog",
        "url": "https://fredblog.stlouisfed.org/feed/",
        "enabled": true,
        "category": "macro-research"
      },
      {
        "name": "BIS Press Releases",
        "url": "https://www.bis.org/doclist/all_pressrels.rss",
        "enabled": true,
        "category": "macro-policy"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 12,
          "min_score": 40,
          "category": "ai-community"
        },
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 12,
          "min_score": 40,
          "category": "ai-community"
        },
        {
          "subreddit": "SecurityAnalysis",
          "enabled": true,
          "sort": "hot",
          "time_filter": "week",
          "fetch_limit": 10,
          "min_score": 10,
          "category": "investment-research"
        },
        {
          "subreddit": "algotrading",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 20,
          "category": "quant"
        }
      ],
      "users": [],
      "fetch_comments": 5
    },
    "telegram": {
      "enabled": false,
      "channels": []
    },
    "twitter": {
      "enabled": false,
      "mode": "apify",
      "users": [],
      "fetch_limit": 10,
      "category": "social",
      "fetch_reply_text": false,
      "max_replies_per_tweet": 3,
      "max_tweets_to_expand": 10,
      "reply_min_likes": 5
    },
    "openbb": {
      "enabled": true,
      "fetch_filings": false,
      "filings_provider": "sec",
      "watchlists": [
        {
          "name": "US Mega-cap and AI",
          "enabled": true,
          "provider": "yfinance",
          "fetch_limit": 25,
          "category": "equities",
          "symbols": [
            "AAPL",
            "MSFT",
            "NVDA",
            "GOOGL",
            "AMZN",
            "META"
          ]
        },
        {
          "name": "Semiconductors",
          "enabled": true,
          "provider": "yfinance",
          "fetch_limit": 20,
          "category": "equities",
          "symbols": [
            "NVDA",
            "AMD",
            "AVGO",
            "TSM",
            "ASML"
          ]
        },
        {
          "name": "Financials",
          "enabled": true,
          "provider": "yfinance",
          "fetch_limit": 20,
          "category": "equities",
          "symbols": [
            "JPM",
            "GS",
            "MS",
            "BRK-B",
            "V",
            "MA"
          ]
        },
        {
          "name": "Cross-asset Dashboard",
          "enabled": true,
          "provider": "yfinance",
          "fetch_limit": 20,
          "category": "markets",
          "symbols": [
            "SPY",
            "QQQ",
            "TLT",
            "GLD",
            "BTC-USD"
          ]
        }
      ]
    },
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "languages": [
        "Python",
        "TypeScript",
        "Rust"
      ],
      "keywords": [],
      "min_stars": 20,
      "max_items": 20,
      "category": "oss-trending"
    },
    "gdelt": {
      "enabled": false,
      "query": "artificial intelligence OR financial markets",
      "mode": "ArtList",
      "max_records": 50,
      "timespan": "36h",
      "language": "english",
      "country": null,
      "category": "global-news"
    },
    "google_news": {
      "enabled": true,
      "query": "(Federal Reserve OR SEC OR earnings OR capital markets OR fintech OR artificial intelligence)",
      "language": "en",
      "country": "US",
      "ceid": "US:en",
      "max_results": 60,
      "category": "finance-news"
    }
  },
  "filtering": {
    "ai_score_threshold": 7.0,
    "time_window_hours": 36,
    "max_items": 28,
    "category_groups": {
      "technology": {
        "name": "AI and Software Engineering",
        "limit": 10,
        "categories": [
          "ai-engineering",
          "dev-platform",
          "engineering",
          "oss-trending",
          "finance-tools"
        ]
      },
      "markets": {
        "name": "Markets and Companies",
        "limit": 9,
        "categories": [
          "equities",
          "markets",
          "finance-news",
          "investment-research",
          "quant"
        ]
      },
      "macro": {
        "name": "Macro and Regulation",
        "limit": 6,
        "categories": [
          "macro-policy",
          "macro-research",
          "regulation",
          "global-news"
        ]
      },
      "community": {
        "name": "Community Signals",
        "limit": 4,
        "categories": [
          "tech-community",
          "ai-community",
          "social"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 2
  },
  "email": {
    "enabled": false,
    "smtp_server": "",
    "smtp_port": 465,
    "imap_enabled": false,
    "imap_server": "",
    "imap_port": 993,
    "email_address": "",
    "sender_name": "Horizon Daily",
    "subscribe_keyword": "SUBSCRIBE",
    "unsubscribe_keyword": "UNSUBSCRIBE"
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary",
    "overview_position": "first",
    "platform": "generic",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": {
      "text": "#{message_title}\n\n#{summary?limit=6000&split=---}"
    },
    "headers": ""
  }
}
